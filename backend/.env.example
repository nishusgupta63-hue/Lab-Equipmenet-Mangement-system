# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file.

# Port the Express server listens on
PORT=5000

# Node environment: development | production
NODE_ENV=development

# MongoDB connection string (local or Atlas)
# Local example:  mongodb://127.0.0.1:27017/labbuddy
# Atlas example:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/labbuddy?retryWrites=true&w=majority
MONGO_URI=

# Comma separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:8080,http://localhost:5173

# Secret used for signing JWTs
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=1d

# Secret code required to register a teacher account (backend only)
TEACHER_REGISTRATION_CODE=change-this-secret-code
